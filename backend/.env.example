# QuickFix AI backend configuration. Copy to backend/.env (never commit .env).
# REQUIRED in production = the API refuses to start without it when ENVIRONMENT=production.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development            # development | test | production (Render sets RENDER=true -> production)
APP_URL=http://localhost:5173      # public web-app URL (used in emails and for the email logo)
FRONTEND_URL=http://localhost:5173 # REQUIRED in production. Comma-separated CORS origins, no wildcards
# CORS_ORIGIN_REGEX=https://quickfix-[a-z0-9-]+\.vercel\.app   # optional: preview deployments
COMPANY_NAME=Quickfix AI
FORWARDED_ALLOW_IPS=127.0.0.1      # Docker/PaaS: proxy IPs whose X-Forwarded-For is trusted

# --- Database: Turso only ----------------------------------------------------
# turso db create quickfix-prod          (and a separate quickfix-staging)
# turso db show quickfix-prod --url      -> TURSO_DATABASE_URL
# turso db tokens create quickfix-prod   -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io    # REQUIRED
TURSO_AUTH_TOKEN=                                        # REQUIRED in production
RUN_MIGRATIONS_ON_STARTUP=true     # false = refuse to start while migrations are pending
DB_CONNECT_TIMEOUT=10
# Offline development only (same libSQL driver, refused in production):
# TURSO_DATABASE_URL=file:local-dev.db

# --- Auth --------------------------------------------------------------------
JWT_SECRET_KEY=                    # REQUIRED in production, >= 32 chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_FAILED=5
LOGIN_LOCKOUT_MINUTES=15
GOOGLE_CLIENT_ID=                  # optional: enables Google sign-in (must equal VITE_GOOGLE_CLIENT_ID)

# --- Email (REQUIRED in production: registration needs OTP delivery) ----------
# Brevo (HTTPS API) is the provider used by this project. Works on Render (no SMTP ports needed).
EMAIL_TRANSPORT=brevo              # brevo | smtp | console (console = dev only, writes .eml to EMAIL_OUTBOX_DIR)
BREVO_API_KEY=                     # REQUIRED: Brevo > SMTP & API > API keys
BREVO_SENDER_EMAIL=support@example.com  # REQUIRED: a sender verified in Brevo (Senders & IP). SENDER_EMAIL also accepted
BREVO_SENDER_NAME=Quickfix AI Support
ADMIN_NOTIFICATION_EMAIL=          # optional: staff copy of new tickets / feedback

# Alternative: plain SMTP (set EMAIL_TRANSPORT=smtp and leave BREVO_API_KEY empty)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587                    # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=support@example.com
# SMTP_FROM_NAME=Quickfix AI Support

# --- AI (optional: without keys the offline keyword analyser is used and every case goes to a human)
GROQ_API_KEY=
GEMINI_API_KEY=                    # comma-separated keys are rotated
AI_TIMEOUT_SECONDS=25
AUTO_RESOLVE_DELAY_SECONDS=300
AUTO_RESOLVE_MIN_CONFIDENCE=0.75

# --- Policy / limits ----------------------------------------------------------
AGENT_CAN_VIEW_UNASSIGNED=false
MAX_REQUEST_BYTES=1000000
MAX_UPLOAD_BYTES=2000000
MAX_ATTACHMENTS_PER_COMPLAINT=3
